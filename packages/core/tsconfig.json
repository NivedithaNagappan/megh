{
  "compilerOptions": {
    // Environment
    "target": "ES2022",
    "module": "commonjs",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",

    // Decorators (typeorm, the DI container, class-validator)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Interop
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // Type checking
    "strict": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "skipLibCheck": true,

    // Node 22 built-ins. Tests import their APIs from vitest.
    "types": ["node"],
    "paths": {
      "knex": ["./node_modules/knex/types/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
